# Copy to .env for local runs; on Render these are set from render.yaml + the UI.
# .env is gitignored — never commit real secrets.

# ---- Backend (API + worker) ----
AEZ_DATABASE_URL=postgresql://aez:aez@localhost:5432/aez
AEZ_REDIS_URL=redis://localhost:6379/0
AEZ_WEATHER_CACHE_DIR=./weather-cache

# Web origins allowed to call the API with credentials (comma-separated).
AEZ_ALLOWED_ORIGINS=http://localhost:5173

# Session cookie. Local dev is same-site over http, so lax + insecure. In
# production the frontend is a different origin over https → none + secure.
AEZ_COOKIE_SAMESITE=lax
AEZ_COOKIE_SECURE=false

# Farmer-PII encryption key. A throwaway dev key is used if unset — that is fine
# locally and NOT fine in production. In prod set a real, secret, backed-up
# value (any passphrase works; lose it and the PII is unrecoverable).
AEZ_PII_KEY=dev-only-change-me

# ---- Frontend (build-time, read by Vite) ----
VITE_API_URL=http://localhost:8000
